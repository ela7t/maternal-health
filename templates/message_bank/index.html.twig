{% extends 'base.html.twig' %}

{% block title %}Clinical Message Bank (78) - Maternal & Newborn Care{% endblock %}

{% block body %}
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-slate-900">MNH Clinical Message Bank & Framing</h3>
        <p class="text-secondary mb-0 small">Validated Jimma Zone 78-message repository aligned with the WHO 8-contact ANC model and Ge'ez UCS-2 segment limits.</p>
    </div>
    <div class="d-flex gap-2">
        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 d-flex align-items-center gap-1">
            <i class="bi bi-shield-check"></i> Clinically Approved
        </span>
    </div>
</div>

<!-- Interactive Amharic Ge'ez Segment Gauge Card -->
<div class="card-custom p-4 mb-4">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h5 class="fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                <i class="bi bi-chat-text text-teal" style="color: var(--app-primary);"></i>
                <span>Interactive Ge'ez / Amharic SMS Length & Billing Meter</span>
            </h5>
            <p class="text-secondary small mb-0">
                Ethio Telecom and Safaricom bill Ge'ez text under <strong>UCS-2 encoding (70 characters per segment)</strong> instead of 160 characters for English. Test any draft below:
            </p>
        </div>
    </div>

    <div class="row g-3 align-items-center">
        <div class="col-lg-8">
            <textarea id="calcInput" class="form-control" rows="3" placeholder="Type or paste Amharic / English text here...">ጤና ይስጥልኝ! በእርግዝና ወቅት የተመጣጠነ ምግብ መመገብ አስፈላጊ ነው።</textarea>
            
            <!-- Character progress bar -->
            <div class="progress mt-2" style="height: 6px;">
                <div id="segmentProgress" class="progress-bar bg-success" role="progressbar" style="width: 75%;"></div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="p-3 rounded border bg-light">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-secondary small">Encoding Format:</span>
                    <span id="resEncoding" class="badge bg-dark fw-semibold">UCS-2 (Ge'ez)</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-secondary small">Length:</span>
                    <span id="resChars" class="fw-bold text-slate-900">53 characters</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-secondary small">Billable Segments:</span>
                    <span id="resSegments" class="badge bg-success-subtle text-success border border-success-subtle fs-6 px-2 py-1">1 Segment</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-secondary small">Remaining in Segment:</span>
                    <span id="resRemaining" class="fw-semibold text-secondary">17 chars</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Message Library Table -->
<div class="card-custom overflow-hidden">
    <div class="card-header-clean bg-light d-flex justify-content-between align-items-center">
        <div class="fw-bold text-dark">
            <i class="bi bi-collection-play me-1 text-teal" style="color: var(--app-primary);"></i> Active Clinical Templates ({{ templates|length }})
        </div>
        <div class="small text-secondary">
            Gain-Framed (Benefits) vs. Loss-Framed (Risk Awareness)
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-custom">
            <thead>
                <tr>
                    <th>Template Code & Milestone</th>
                    <th>Clinical Topic</th>
                    <th>Amharic Gain-Framed (Benefits)</th>
                    <th>Amharic Loss-Framed (Cautions)</th>
                </tr>
            </thead>
            <tbody>
                {% for tpl in templates %}
                    {% set gainVar = tpl.getVariant('am', 'gain') %}
                    {% set lossVar = tpl.getVariant('am', 'loss') %}
                    <tr>
                        <td>
                            <div class="fw-bold text-dark">{{ tpl.code }}</div>
                            {% if tpl.gaFromWeeks is not null %}
                                <span class="badge-clinical pregnant mt-1">
                                    <i class="bi bi-calendar3"></i> Weeks {{ tpl.gaFromWeeks }}–{{ tpl.gaToWeeks }}
                                </span>
                            {% elseif tpl.pncDayFrom is not null %}
                                <span class="badge-clinical postnatal mt-1">
                                    <i class="bi bi-flower1"></i> Day {{ tpl.pncDayFrom }}–{{ tpl.pncDayTo }} Postnatal
                                </span>
                            {% else %}
                                <span class="badge-clinical completed mt-1">Visit Reminder (72h)</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="fw-semibold text-dark">{{ tpl.topic }}</div>
                            <span class="text-muted small text-capitalize">{{ tpl.stream }}</span>
                        </td>
                        <td style="max-width: 340px;">
                            {% if gainVar %}
                                <div class="small text-dark mb-1">{{ gainVar.body }}</div>
                                <span class="badge bg-light text-secondary border small">{{ gainVar.segmentCount }} segment (UCS-2)</span>
                            {% else %}
                                <span class="text-muted small">—</span>
                            {% endif %}
                        </td>
                        <td style="max-width: 340px;">
                            {% if lossVar %}
                                <div class="small text-dark mb-1">{{ lossVar.body }}</div>
                                <span class="badge bg-light text-secondary border small">{{ lossVar.segmentCount }} segment (UCS-2)</span>
                            {% else %}
                                <span class="text-muted small">—</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center text-muted py-5">No templates loaded.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<script>
const calcInput = document.getElementById('calcInput');
const progress = document.getElementById('segmentProgress');

calcInput.addEventListener('input', function() {
    fetch('{{ path("app_api_calculate_segments") }}', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({text: this.value})
    })
    .then(r => r.json())
    .then(data => {
        document.getElementById('resEncoding').textContent = data.encoding + (data.is_geez_amharic ? ' (Ge\'ez)' : '');
        document.getElementById('resChars').textContent = data.char_count + ' characters';
        document.getElementById('resSegments').textContent = data.segment_count + ' Segment' + (data.segment_count > 1 ? 's' : '');
        document.getElementById('resRemaining').textContent = data.remaining_in_segment + ' chars';

        // Calculate progress percentage inside current segment
        const limit = data.encoding === 'UCS-2' ? 70 : 160;
        const pct = Math.min(100, Math.round((data.char_count / limit) * 100));
        progress.style.width = pct + '%';
        if (data.segment_count > 1) {
            progress.className = 'progress-bar bg-warning';
        } else {
            progress.className = 'progress-bar bg-success';
        }
    });
});
</script>
{% endblock %}
