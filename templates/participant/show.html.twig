{% extends 'base.html.twig' %}

{% block title %}{{ participant.fullName }} - Mother Care Profile{% endblock %}

{% block body %}
<!-- Patient Header -->
<div class="card-custom p-4 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="patient-avatar fs-4" style="width: 52px; height: 52px;">
                {{ participant.fullName|slice(0, 1) }}
            </div>
            <div>
                <div class="d-flex align-items-center gap-2">
                    <h3 class="fw-bold mb-0 text-slate-900">{{ participant.fullName }}</h3>
                    <span class="badge bg-light text-secondary border font-monospace">{{ participant.publicCode }}</span>
                </div>
                <div class="text-secondary small mt-1">
                    <i class="bi bi-geo-alt me-1"></i> {{ participant.facility.name }} &bull; {{ participant.kebele }} &bull; Enrolled: {{ participant.enrolledAt|date('M d, Y') }}
                </div>
            </div>
        </div>

        <!-- Clinical State & Action Buttons -->
        <div class="d-flex flex-wrap gap-2">
            {% if participant.status == 'active_pregnant' %}
                <button type="button" class="btn btn-success d-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#deliveryModal">
                    <i class="bi bi-gift-fill"></i> Record Delivery
                </button>
            {% endif %}

            {% if participant.status in ['active_pregnant', 'postnatal'] %}
                <button type="button" class="btn btn-outline-danger btn-sm d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#lossModal">
                    <i class="bi bi-heartbreak"></i> Sensitive Loss
                </button>
                <form method="POST" action="{{ path('app_participant_opt_out', {id: participant.id}) }}" class="d-inline" onsubmit="return confirm('Immediately stop all automated SMS for this mother?');">
                    <button type="submit" class="btn btn-outline-warning btn-sm d-flex align-items-center gap-1">
                        <i class="bi bi-slash-circle"></i> Opt-Out
                    </button>
                </form>
            {% endif %}
            <a href="{{ path('app_participants_list') }}" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
                <i class="bi bi-arrow-left"></i> Registry
            </a>
        </div>
    </div>

    <!-- Longitudinal Maternity Stepper -->
    {% set preg = participant.currentPregnancy %}
    <div class="mt-4 pt-3 border-top">
        <div class="stepper-container">
            <div class="step-item {% if gaInfo and gaInfo.trimester >= 1 %}completed{% endif %}">
                <span class="step-dot">1</span>
                <span class="step-label">1st Trimester<br><small class="text-muted">(1–13 wks)</small></span>
            </div>
            <div class="step-item {% if gaInfo and gaInfo.trimester == 2 %}active{% elseif gaInfo and gaInfo.trimester > 2 or participant.status == 'postnatal' %}completed{% endif %}">
                <span class="step-dot">2</span>
                <span class="step-label">2nd Trimester<br><small class="text-muted">(14–27 wks)</small></span>
            </div>
            <div class="step-item {% if gaInfo and gaInfo.trimester == 3 and participant.status == 'active_pregnant' %}active{% elseif participant.status in ['postnatal', 'completed'] %}completed{% endif %}">
                <span class="step-dot">3</span>
                <span class="step-label">3rd Trimester<br><small class="text-muted">(28–40 wks)</small></span>
            </div>
            <div class="step-item {% if participant.status == 'postnatal' %}active{% elseif participant.status == 'completed' %}completed{% endif %}">
                <span class="step-dot">
                    <i class="bi bi-heart-pulse-fill"></i>
                </span>
                <span class="step-label">Postnatal Care<br><small class="text-muted">(Day 1–42)</small></span>
            </div>
            <div class="step-item {% if participant.status == 'completed' %}completed{% endif %}">
                <span class="step-dot"><i class="bi bi-check-lg"></i></span>
                <span class="step-label">Graduated<br><small class="text-muted">(6 Weeks)</small></span>
            </div>
        </div>
    </div>
</div>

<!-- Grid: Clinical Obstetric Card + Contact Card -->
<div class="row g-4 mb-4">
    <!-- Clinical Obstetric Card -->
    <div class="col-lg-7">
        <div class="card-custom p-4 h-100">
            <h5 class="fw-bold mb-3 d-flex align-items-center gap-2 text-dark">
                <i class="bi bi-clipboard2-pulse text-teal" style="color: var(--app-primary);"></i>
                <span>Obstetric & Gestational Profile</span>
            </h5>

            {% if pregnancy %}
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="p-3 rounded border bg-light">
                            <span class="text-secondary small fw-medium">Estimated Due Date (GC)</span>
                            <div class="fs-4 fw-bold text-slate-900 mt-1">{{ pregnancy.eddDate|date('M d, Y') }}</div>
                            <small class="text-muted">Calculated via Naegele's rule (LMP + 280d)</small>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="p-3 rounded border bg-light">
                            <span class="text-secondary small fw-medium">EDD in Ethiopian Calendar (ዓ.ም)</span>
                            <div class="fs-4 fw-bold text-teal mt-1" style="color: var(--app-primary);">{{ eddEth.formatted_am }}</div>
                            <small class="text-muted">{{ eddEth.month_name_en }} ({{ eddEth.formatted_en }})</small>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="p-3 rounded border bg-light">
                            <span class="text-secondary small fw-medium">Gestational Age Status</span>
                            {% if gaInfo %}
                                <div class="fs-5 fw-bold text-primary mt-1">{{ gaInfo.formatted }}</div>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle small mt-1">
                                    Trimester {{ gaInfo.trimester }} Active
                                </span>
                            {% else %}
                                <div class="text-muted mt-1">—</div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="p-3 rounded border bg-light">
                            <span class="text-secondary small fw-medium">Clinical Risk Assessment</span>
                            <div class="fs-5 fw-bold text-slate-900 mt-1 text-capitalize">{{ pregnancy.riskStatus }} Risk</div>
                            <small class="text-muted">Dating Method: {{ pregnancy.datingMethod|upper }}</small>
                        </div>
                    </div>

                    {% if pregnancy.deliveredAt %}
                        <div class="col-12">
                            <div class="p-3 rounded border border-success-subtle bg-success-subtle bg-opacity-25">
                                <div class="d-flex align-items-center gap-2 text-success fw-bold">
                                    <i class="bi bi-gift-fill fs-5"></i> Delivery Event Confirmed
                                </div>
                                <div class="mt-1 text-dark small">
                                    Delivered on <strong>{{ pregnancy.deliveredAt|date('M d, Y H:i') }}</strong> at <strong>{{ pregnancy.deliveryPlace }}</strong>.
                                </div>
                                {% for baby in pregnancy.babies %}
                                    <div class="badge bg-success text-white mt-2 px-3 py-1">
                                        <i class="bi bi-person-heart me-1"></i> {{ baby.name ?: 'Baby' }} ({{ baby.babyCode }})
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>

    <!-- Contact & Message Configuration Card -->
    <div class="col-lg-5">
        <div class="card-custom p-4 h-100">
            <h5 class="fw-bold mb-3 d-flex align-items-center gap-2 text-dark">
                <i class="bi bi-telephone text-teal" style="color: var(--app-primary);"></i>
                <span>Contact & Automated Delivery</span>
            </h5>

            {% set ph = participant.primaryPhone %}
            <ul class="list-unstyled mb-0">
                <li class="p-3 rounded border bg-light mb-3">
                    <span class="text-secondary small fw-medium">Delivery Phone Number</span>
                    <div class="fs-5 fw-bold text-slate-900 mt-1">{{ ph ? ph.numberE164 : 'No phone recorded' }}</div>
                    <div class="d-flex gap-2 mt-2">
                        <span class="badge bg-white text-dark border small">Device Owner: {{ ph ? ph.ownerType|capitalize : 'Unknown' }}</span>
                        <span class="badge bg-white text-success border small"><i class="bi bi-shield-check"></i> Non-diagnostic SMS</span>
                    </div>
                </li>

                <li class="p-3 rounded border bg-light mb-3">
                    <span class="text-secondary small fw-medium">Language & Message Tone</span>
                    <div class="fw-bold text-dark mt-1">
                        {% if participant.preferredLanguage == 'am' %}Amharic (አማርኛ)
                        {% elseif participant.preferredLanguage == 'gurage' %}Gurage
                        {% else %}English{% endif %}
                    </div>
                    <div class="text-muted small mt-1">
                        Tone: {{ participant.studyArm == 'intervention_gain' ? 'Gain-framed (Encouraging benefits)' : 'Loss-framed (Risk awareness)' }}
                    </div>
                </li>

                <li class="p-3 rounded border bg-light">
                    <span class="text-secondary small fw-medium">Assigned Health Facility</span>
                    <div class="fw-bold text-dark mt-1">{{ participant.facility.name }}</div>
                    <small class="text-secondary">{{ participant.facility.woreda }}, {{ participant.facility.zone }} Zone</small>
                </li>
            </ul>
        </div>
    </div>
</div>

<!-- Tabs: Clinical Appointments & Dispatched SMS History -->
<div class="card-custom overflow-hidden mb-4">
    <div class="card-header-clean bg-light">
        <ul class="nav nav-tabs card-header-tabs" id="profileTabs">
            <li class="nav-item">
                <button class="nav-link active fw-semibold" id="tabAptBtn" data-bs-toggle="tab" data-bs-target="#tabAppointments">
                    <i class="bi bi-calendar-check me-1"></i> Checkups & Visits ({{ appointments|length }})
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link fw-semibold" id="tabMsgBtn" data-bs-toggle="tab" data-bs-target="#tabMessages">
                    <i class="bi bi-chat-left-text me-1"></i> Dispatched SMS Log ({{ outboxMessages|length }})
                </button>
            </li>
        </ul>
    </div>

    <div class="tab-content p-4" id="profileTabsContent">
        <!-- Appointments Tab -->
        <div class="tab-pane fade show active" id="tabAppointments">
            <div class="table-responsive">
                <table class="table table-custom">
                    <thead>
                        <tr>
                            <th>Visit Type</th>
                            <th>Scheduled Date</th>
                            <th>Status</th>
                            <th>Recorded By</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for apt in appointments %}
                            <tr>
                                <td>
                                    <span class="badge bg-light text-dark border">{{ apt.kind|upper }}</span>
                                </td>
                                <td class="fw-bold text-slate-900">{{ apt.scheduledFor|date('M d, Y H:i') }}</td>
                                <td>
                                    {% if apt.status == 'attended' %}
                                        <span class="badge-clinical postnatal"><i class="bi bi-check2"></i> Attended</span>
                                    {% elseif apt.status == 'missed' %}
                                        <span class="badge-clinical missed"><i class="bi bi-exclamation-triangle"></i> Missed</span>
                                    {% elseif apt.status == 'rescheduled' %}
                                        <span class="badge-clinical opted-out"><i class="bi bi-arrow-repeat"></i> Rescheduled</span>
                                    {% else %}
                                        <span class="badge-clinical pregnant"><i class="bi bi-clock"></i> Scheduled</span>
                                    {% endif %}
                                </td>
                                <td class="text-secondary small">{{ apt.recordedBy }}</td>
                                <td class="text-secondary small">{{ apt.notes ?: 'Routine Checkup' }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">No visits scheduled yet.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- SMS Outbox Tab -->
        <div class="tab-pane fade" id="tabMessages">
            <div class="table-responsive">
                <table class="table table-custom">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>SMS Content</th>
                            <th>Segments</th>
                            <th>Status</th>
                            <th>Sent Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for msg in outboxMessages %}
                            <tr>
                                <td class="text-muted small">#{{ msg.id }}</td>
                                <td style="max-width: 480px;">
                                    <div class="small text-dark">{{ msg.messageContent }}</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border small">{{ msg.segments }} seg</span>
                                </td>
                                <td>
                                    {% if msg.status in ['sent', 'delivered', 'submitted'] %}
                                        <span class="badge-clinical postnatal"><i class="bi bi-check2"></i> {{ msg.status|capitalize }}</span>
                                    {% elseif msg.status == 'pending' %}
                                        <span class="badge-clinical opted-out">Queued</span>
                                    {% elseif msg.status == 'cancelled' %}
                                        <span class="badge-clinical completed">Cancelled</span>
                                    {% else %}
                                        <span class="badge-clinical missed">Failed</span>
                                    {% endif %}
                                </td>
                                <td class="text-secondary small">{{ msg.sentAt ? msg.sentAt|date('M d, H:i') : msg.scheduledAt|date('M d, H:i') }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">No automated messages dispatched yet.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Record Delivery -->
<div class="modal fade" id="deliveryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form method="POST" action="{{ path('app_participant_delivery', {id: participant.id}) }}">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold text-dark"><i class="bi bi-gift-fill text-success me-2"></i>Record Birth & Delivery</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-secondary small mb-3">Recording delivery automatically concludes antenatal pregnancy messages and starts the 6-week postnatal newborn care stream.</p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Delivery Date & Time</label>
                        <input type="datetime-local" name="delivery_date" class="form-control" value="{{ 'now'|date('Y-m-d\\TH:i') }}" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Delivery Location</label>
                        <select name="delivery_place" class="form-select">
                            <option value="{{ participant.facility.name }}">{{ participant.facility.name }} (Facility Delivery)</option>
                            <option value="Home Delivery">Home Delivery</option>
                            <option value="In Transit">In Transit</option>
                            <option value="Other Facility">Other Facility</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold text-secondary">Baby Name / Code</label>
                        <input type="text" name="baby_name" class="form-control" placeholder="e.g. Baby Dawit">
                    </div>
                </div>
                <div class="modal-footer border-top bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success fw-bold">Confirm Delivery & Switch Stream</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Record Sensitive Loss -->
<div class="modal fade" id="lossModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-danger shadow">
            <form method="POST" action="{{ path('app_participant_loss', {id: participant.id}) }}">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Emergency Sensitive Loss Halt</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-danger fw-semibold small mb-3">
                        To protect the mother and family from severe distress, this immediately halts all automated SMS messages and creates an audit flag for supportive human follow-up.
                    </p>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold text-secondary">Classification of Loss</label>
                        <select name="loss_outcome" class="form-select" required>
                            <option value="miscarriage">Early Miscarriage</option>
                            <option value="stillbirth">Stillbirth</option>
                            <option value="neonatal_death">Neonatal Mortality</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger fw-bold">Confirm & Halt All Automated Messages</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
