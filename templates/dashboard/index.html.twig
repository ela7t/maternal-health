{% extends 'base.html.twig' %}

{% block title %}Clinical Overview - Maternal & Newborn Care{% endblock %}

{% block body %}
<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-slate-900">Today's Clinic & Messaging Overview</h3>
        <p class="text-secondary mb-0 small">Monitoring registered mothers, appointment attendance, and automated prenatal/postnatal SMS streams.</p>
    </div>
    <div class="d-flex gap-2">
        <form method="POST" action="{{ path('app_outbox_run_now') }}" class="d-inline">
            <button type="submit" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1 shadow-sm">
                <i class="bi bi-arrow-repeat"></i> Sync Scheduler Now
            </button>
        </form>
        <a href="{{ path('app_participant_new') }}" class="btn-medical btn-sm shadow-sm">
            <i class="bi bi-person-plus-fill"></i> Register New Mother
        </a>
    </div>
</div>

<!-- Immediate Clinical Action Banner (Triage) -->
{% if missedAppointments > 0 %}
<div class="action-banner danger shadow-sm">
    <div class="d-flex align-items-center gap-3">
        <div class="rounded-circle bg-danger bg-opacity-10 p-2 text-danger fs-5 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <div>
            <div class="fw-bold">{{ missedAppointments }} Mother{{ missedAppointments > 1 ? 's' : '' }} Missed Scheduled Appointments</div>
            <div class="small">The system sent an automatic rescheduling SMS. Please review and call to arrange a new visit date.</div>
        </div>
    </div>
    <a href="{{ path('app_appointments_list', {filter: 'missed'}) }}" class="btn btn-sm btn-danger fw-semibold px-3 text-nowrap">
        Review Missed Visits <i class="bi bi-arrow-right ms-1"></i>
    </a>
</div>
{% endif %}

<!-- Primary Clinical Metrics Row -->
<div class="row g-3 mb-4">
    <!-- Active Pregnancies -->
    <div class="col-xl-3 col-md-6">
        <div class="card-custom p-3 h-100 d-flex flex-column justify-content-between">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-secondary small fw-semibold text-uppercase tracking-wider">Active Pregnancies</span>
                    <h2 class="fw-bold text-slate-900 mt-2 mb-0">{{ activePregnant }}</h2>
                </div>
                <div class="rounded-3 bg-teal bg-opacity-10 p-2" style="background-color: var(--app-primary-light); color: var(--app-primary);">
                    <i class="bi bi-person-heart fs-4"></i>
                </div>
            </div>
            <div class="mt-3 pt-2 border-top d-flex align-items-center justify-content-between text-secondary small">
                <span>Receiving prenatal SMS</span>
                <a href="{{ path('app_participants_list', {status: 'active_pregnant'}) }}" class="text-decoration-none fw-semibold" style="color: var(--app-primary);">View list &rarr;</a>
            </div>
        </div>
    </div>

    <!-- Postnatal Mothers -->
    <div class="col-xl-3 col-md-6">
        <div class="card-custom p-3 h-100 d-flex flex-column justify-content-between">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-secondary small fw-semibold text-uppercase tracking-wider">Postnatal Care (0–6 Wks)</span>
                    <h2 class="fw-bold text-slate-900 mt-2 mb-0">{{ activePostnatal }}</h2>
                </div>
                <div class="rounded-3 p-2" style="background-color: var(--app-success-light); color: var(--app-success);">
                    <i class="bi bi-flower1 fs-4"></i>
                </div>
            </div>
            <div class="mt-3 pt-2 border-top d-flex align-items-center justify-content-between text-secondary small">
                <span>Newborn immunization stream</span>
                <a href="{{ path('app_participants_list', {status: 'postnatal'}) }}" class="text-decoration-none fw-semibold text-success">View list &rarr;</a>
            </div>
        </div>
    </div>

    <!-- Today & Upcoming Visits -->
    <div class="col-xl-3 col-md-6">
        <div class="card-custom p-3 h-100 d-flex flex-column justify-content-between">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-secondary small fw-semibold text-uppercase tracking-wider">Upcoming ANC Visits</span>
                    <h2 class="fw-bold text-slate-900 mt-2 mb-0">{{ scheduledAppointments }}</h2>
                </div>
                <div class="rounded-3 p-2" style="background-color: var(--app-info-light); color: var(--app-info);">
                    <i class="bi bi-calendar-check fs-4"></i>
                </div>
            </div>
            <div class="mt-3 pt-2 border-top d-flex align-items-center justify-content-between text-secondary small">
                <span>72h advance reminders active</span>
                <a href="{{ path('app_appointments_list', {filter: 'scheduled'}) }}" class="text-decoration-none fw-semibold text-info">View visits &rarr;</a>
            </div>
        </div>
    </div>

    <!-- Completed Program -->
    <div class="col-xl-3 col-md-6">
        <div class="card-custom p-3 h-100 d-flex flex-column justify-content-between">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-secondary small fw-semibold text-uppercase tracking-wider">Graduated Cohort</span>
                    <h2 class="fw-bold text-slate-900 mt-2 mb-0">{{ completed }}</h2>
                </div>
                <div class="rounded-3 bg-light p-2 text-secondary">
                    <i class="bi bi-shield-check fs-4"></i>
                </div>
            </div>
            <div class="mt-3 pt-2 border-top d-flex align-items-center justify-content-between text-secondary small">
                <span>Completed full 6-week care</span>
                <span class="text-muted">{{ totalEnrolled }} Total Enrolled</span>
            </div>
        </div>
    </div>
</div>

<!-- Middle Section: Delivery Performance & Telephony Status -->
<div class="row g-3 mb-4">
    <!-- Messaging & Delivery Status Card -->
    <div class="col-lg-8">
        <div class="card-custom p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold mb-1"><i class="bi bi-broadcast text-teal me-2" style="color: var(--app-primary);"></i>Automated SMS Delivery Health</h5>
                    <small class="text-secondary">Connected to Ethio Telecom & Safaricom routes through AfroMessage Gateway</small>
                </div>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1">
                    <i class="bi bi-circle-fill fs-8 me-1 text-success"></i> Gateway Online
                </span>
            </div>

            <div class="row g-3 my-1">
                <div class="col-sm-4">
                    <div class="p-3 rounded border bg-light text-center">
                        <div class="text-secondary small fw-medium">Messages Dispatched</div>
                        <div class="fs-3 fw-bold text-slate-900 mt-1">{{ totalSms }}</div>
                        <div class="text-muted small">Total automated SMS</div>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="p-3 rounded border bg-light text-center">
                        <div class="text-secondary small fw-medium">Successfully Delivered</div>
                        <div class="fs-3 fw-bold text-success mt-1">{{ sentSms }}</div>
                        <div class="text-muted small">Confirmed by network</div>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="p-3 rounded border bg-light text-center">
                        <div class="text-secondary small fw-medium">Delivery Rate</div>
                        <div class="fs-3 fw-bold text-primary mt-1">{{ deliverySuccessRate }}%</div>
                        <div class="text-muted small">Jimma trial target: >95%</div>
                    </div>
                </div>
            </div>

            <div class="mt-3 p-3 rounded bg-light border d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                <div class="small text-secondary">
                    <i class="bi bi-clock-history me-1 text-teal" style="color: var(--app-primary);"></i>
                    Preferred sending windows: <strong>8:00 AM – 10:00 AM</strong> and <strong>7:00 PM</strong> (Addis Ababa Time).
                </div>
                <a href="{{ path('app_outbox_list') }}" class="btn btn-sm btn-outline-secondary text-nowrap">View Outbox Details</a>
            </div>
        </div>
    </div>

    <!-- Clinical Safety & Program Compliance -->
    <div class="col-lg-4">
        <div class="card-custom p-4 h-100">
            <h5 class="fw-bold mb-3"><i class="bi bi-shield-shaded me-2" style="color: var(--app-primary);"></i>Program Safety & Privacy</h5>
            <ul class="list-unstyled mb-0">
                <li class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <div>
                        <div class="fw-semibold text-slate-900 small">Shared Phone Protection</div>
                        <small class="text-secondary">No PII or diagnosis in SMS body</small>
                    </div>
                    <span class="badge bg-light text-success border"><i class="bi bi-check-lg"></i> Active</span>
                </li>
                <li class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <div>
                        <div class="fw-semibold text-slate-900 small">Opt-Out Requests</div>
                        <small class="text-secondary">Mothers replied STOP / አቁም</small>
                    </div>
                    <span class="badge bg-light text-dark border">{{ optedOut }}</span>
                </li>
                <li class="d-flex justify-content-between align-items-center py-2">
                    <div>
                        <div class="fw-semibold text-slate-900 small">Sensitive Branch Flags</div>
                        <small class="text-secondary">Immediate halt on pregnancy loss</small>
                    </div>
                    <span class="badge bg-light text-danger border">{{ lossCount }}</span>
                </li>
            </ul>
        </div>
    </div>
</div>

<!-- Recent Mother Activity Table -->
<div class="card-custom overflow-hidden">
    <div class="card-header-clean">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-clock-history text-teal" style="color: var(--app-primary);"></i>
            <span>Recent Automated Messages</span>
        </div>
        <a href="{{ path('app_outbox_list') }}" class="btn btn-sm btn-outline-secondary">See all messages</a>
    </div>

    <div class="table-responsive">
        <table class="table table-custom">
            <thead>
                <tr>
                    <th>Mother</th>
                    <th>Facility & Phone</th>
                    <th>Message Sent</th>
                    <th>Encoding & Segments</th>
                    <th>Delivery Status</th>
                    <th>Scheduled For</th>
                </tr>
            </thead>
            <tbody>
                {% for msg in recentMessages %}
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="patient-avatar">
                                    {{ msg.participant.fullName|slice(0, 1) }}
                                </div>
                                <div>
                                    <a href="{{ path('app_participant_show', {id: msg.participant.id}) }}" class="fw-bold text-decoration-none text-dark d-block">
                                        {{ msg.participant.fullName }}
                                    </a>
                                    <span class="text-muted small">{{ msg.participant.publicCode }}</span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="small fw-semibold text-dark">{{ msg.participant.facility.name }}</div>
                            <small class="text-secondary">{{ msg.phone.numberE164 }} ({{ msg.phone.ownerType|capitalize }})</small>
                        </td>
                        <td style="max-width: 380px;">
                            <div class="small text-slate-700 text-truncate" title="{{ msg.messageContent }}">
                                {{ msg.messageContent }}
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border small">{{ msg.segments }} segment{{ msg.segments > 1 ? 's' : '' }}</span>
                        </td>
                        <td>
                            {% if msg.status in ['sent', 'delivered', 'submitted'] %}
                                <span class="badge-clinical postnatal">
                                    <i class="bi bi-check2"></i> Delivered
                                </span>
                            {% elseif msg.status == 'pending' %}
                                <span class="badge-clinical opted-out">
                                    <i class="bi bi-hourglass-split"></i> Queued
                                </span>
                            {% elseif msg.status == 'cancelled' %}
                                <span class="badge-clinical completed">
                                    <i class="bi bi-dash-circle"></i> Cancelled
                                </span>
                            {% else %}
                                <span class="badge-clinical missed">
                                    <i class="bi bi-x-circle"></i> Failed
                                </span>
                            {% endif %}
                        </td>
                        <td class="text-secondary small">
                            {{ msg.scheduledAt|date('M d, H:i') }}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            No recent outbox activity. Register a mother to initiate automated scheduling.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
