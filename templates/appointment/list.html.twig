{% extends 'base.html.twig' %}

{% block title %}Clinical Visits - Maternal & Newborn Care{% endblock %}

{% block body %}
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-slate-900">Antenatal & Postnatal Checkups</h3>
        <p class="text-secondary mb-0 small">Track scheduled clinic visits, record attendance, and follow up on missed checkups.</p>
    </div>
    <div class="btn-group btn-group-sm" role="group">
        <a href="{{ path('app_appointments_list', {filter: 'all'}) }}" class="btn btn-outline-secondary {% if currentFilter == 'all' %}active{% endif %}">All Visits</a>
        <a href="{{ path('app_appointments_list', {filter: 'today'}) }}" class="btn btn-outline-secondary {% if currentFilter == 'today' %}active{% endif %}">Today's Clinic</a>
        <a href="{{ path('app_appointments_list', {filter: 'scheduled'}) }}" class="btn btn-outline-secondary {% if currentFilter == 'scheduled' %}active{% endif %}">Upcoming (72h SMS)</a>
        <a href="{{ path('app_appointments_list', {filter: 'missed'}) }}" class="btn btn-outline-danger {% if currentFilter == 'missed' %}active{% endif %}">
            <i class="bi bi-exclamation-circle-fill me-1"></i> Missed Follow-ups
        </a>
    </div>
</div>

<div class="card-custom overflow-hidden">
    <div class="card-header-clean bg-light d-flex justify-content-between align-items-center">
        <span class="fw-bold text-dark">
            <i class="bi bi-calendar2-check text-teal me-1" style="color: var(--app-primary);"></i> Visit Appointments ({{ appointments|length }})
        </span>
        <span class="text-secondary small">72-hour reminders automated</span>
    </div>

    <div class="table-responsive">
        <table class="table table-custom">
            <thead>
                <tr>
                    <th>Mother Profile</th>
                    <th>Visit Stage</th>
                    <th>Scheduled Date</th>
                    <th>Facility</th>
                    <th>Attendance Status</th>
                    <th class="text-end">Clinical Action</th>
                </tr>
            </thead>
            <tbody>
                {% for apt in appointments %}
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="patient-avatar">
                                    {{ apt.participant.fullName|slice(0, 1) }}
                                </div>
                                <div>
                                    <a href="{{ path('app_participant_show', {id: apt.participant.id}) }}" class="fw-bold text-dark text-decoration-none d-block">
                                        {{ apt.participant.fullName }}
                                    </a>
                                    <small class="text-muted">{{ apt.participant.primaryPhone ? apt.participant.primaryPhone.numberE164 : 'No phone' }}</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border fw-semibold">
                                {{ apt.kind == 'anc' ? 'Antenatal Checkup' : 'Postnatal Checkup' }}
                            </span>
                        </td>
                        <td>
                            <div class="fw-bold text-slate-900">{{ apt.scheduledFor|date('M d, Y') }}</div>
                            <small class="text-secondary">{{ apt.scheduledFor|date('H:i A') }}</small>
                        </td>
                        <td>
                            <span class="small text-secondary">{{ apt.participant.facility.name }}</span>
                        </td>
                        <td>
                            {% if apt.status == 'attended' %}
                                <span class="badge-clinical postnatal"><i class="bi bi-check2"></i> Attended</span>
                            {% elseif apt.status == 'missed' %}
                                <span class="badge-clinical missed"><i class="bi bi-exclamation-triangle"></i> Missed Checkup</span>
                            {% elseif apt.status == 'rescheduled' %}
                                <span class="badge-clinical opted-out"><i class="bi bi-arrow-repeat"></i> Rescheduled</span>
                            {% else %}
                                <span class="badge-clinical pregnant"><i class="bi bi-clock"></i> Scheduled</span>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                {% if apt.status in ['scheduled', 'missed'] %}
                                    <form method="POST" action="{{ path('app_appointment_attend', {id: apt.id}) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-success fw-semibold">
                                            <i class="bi bi-check-lg"></i> Attended
                                        </button>
                                    </form>
                                    <button type="button" class="btn btn-sm btn-outline-secondary fw-semibold" data-bs-toggle="modal" data-bs-target="#rescheduleModal{{ apt.id }}">
                                        <i class="bi bi-calendar-plus"></i> Reschedule
                                    </button>

                                    <!-- Reschedule Modal -->
                                    <div class="modal fade" id="rescheduleModal{{ apt.id }}" tabindex="-1">
                                        <div class="modal-dialog">
                                            <div class="modal-content border-0 shadow text-start">
                                                <form method="POST" action="{{ path('app_appointment_reschedule', {id: apt.id}) }}">
                                                    <div class="modal-header border-bottom">
                                                        <h5 class="modal-title fw-bold">Reschedule Appointment</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body p-4">
                                                        <p class="small text-muted mb-3">Mother: <strong>{{ apt.participant.fullName }}</strong> ({{ apt.participant.publicCode }})</p>
                                                        <div class="mb-2">
                                                            <label class="form-label small fw-semibold text-secondary">New Appointment Date & Time</label>
                                                            <input type="datetime-local" name="new_date" class="form-control" required>
                                                            <small class="text-muted">A new 72-hour reminder will be automatically queued for this date.</small>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer border-top bg-light">
                                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-primary fw-bold">Confirm Reschedule</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                {% else %}
                                    <span class="text-muted small">Completed</span>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            No visits found under this filter.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
